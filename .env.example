# Copia este archivo como .env y cambia los valores.

# --- Base de datos (los lee docker-compose.yml) ---
MYSQL_ROOT_PASSWORD=cambia_esto
MYSQL_DATABASE=ikamoney
MYSQL_USER=ikamoney
MYSQL_PASSWORD=cambia_esto
MYSQL_PORT=3307

# --- Backend (FastAPI) ---
# Debe coincidir con usuario, contraseña, puerto y base de arriba.
# Con Docker el host es "db"; sin Docker, normalmente "localhost".
DATABASE_URL=mysql+pymysql://ikamoney:cambia_esto@db:3306/ikamoney
CORS_ORIGINS=http://localhost:5173

# Clave para la integración con IA (aún no se usa)
AI_API_KEY=

# Clave para firmar los tokens JWT (usa una larga y aleatoria)
JWT_SECRET=cambia_esto
