# Copia este archivo como .env y cambia los valores.

# --- Base de datos (los lee docker-compose.yml) ---
MYSQL_ROOT_PASSWORD=cambia_esto
MYSQL_DATABASE=ikamoney
MYSQL_USER=ikamoney
MYSQL_PASSWORD=cambia_esto
MYSQL_PORT=3307

# --- Backend (FastAPI) ---
# Debe coincidir con usuario, contraseña, puerto y base de arriba.
# Con Docker el host es "db"; sin Docker, normalmente "localhost".
DATABASE_URL=mysql+pymysql://ikamoney:cambia_esto@db:3306/ikamoney
CORS_ORIGINS=http://localhost:5173

# Llave de la API de Gemini para leer estados de cuenta (T31). Solo vive en el servidor:
# va en tu .env y en la VM, nunca en el código. Sin ella, /estados-cuenta/extraer responde 503.
AI_API_KEY=

# Llave de cifrado de montos sensibles (T53b, AES-256): 32 bytes en base64. OBLIGATORIA: sin ella la API
# no arranca. Genérala con:
#   python -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# Guárdala TAMBIÉN fuera del servidor y aparte de los respaldos: si se pierde, los datos no se recuperan.
CIFRADO_LLAVE=

# Clave para firmar los tokens JWT (usa una larga y aleatoria)
JWT_SECRET=cambia_esto

# Recuperación de contraseña: sin servicio de correo, en desarrollo se puede devolver el enlace
# en la respuesta. Déjalo en false en producción.
RECUPERACION_ENLACE_PRUEBA=false
FRONTEND_URL=http://localhost:5173

# Llave que manda el cron en el encabezado X-Llave-Interna para llamar a
# POST /api/internos/revision-diaria (T47/T50). Larga y aleatoria. Vacía = la ruta responde 503.
CRON_SECRET=

# Correo de alertas (T50), con la API HTTP de Brevo (https://www.brevo.com). Verifica en su panel la
# dirección del remitente. Sin CORREO_API_KEY la app funciona igual pero no envía correos.
CORREO_API_KEY=
CORREO_REMITENTE=
CORREO_REMITENTE_NOMBRE=IKAMONEY
